+# Tolkien Work Mapping
+# Lord of the Rings specific character and concept translations
+
+work_metadata:
+  title: "The Lord of the Rings"
+  author: "J.R.R. Tolkien"
+  key_challenges:
+    - "Mass warfare (Helm's Deep, Pelennor)"
+    - "Psychological collapse (Denethor)"
+    - "Moral failure at climax (Frodo)"
+    - "Bittersweet ending (Grey Havens)"
+
